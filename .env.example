# Configuración de Google OAuth2
# Obtén estas credenciales en: https://console.cloud.google.com/
# Tipo de aplicación: Aplicación de escritorio
# URI de redirección: http://127.0.0.1:1420/oauth/callback
GOOGLE_CLIENT_ID=TU_CLIENT_ID_AQUI
GOOGLE_CLIENT_SECRET=TU_CLIENT_SECRET_AQUI

# Configuración de Groq API (opcional, para procesamiento de lenguaje natural)
# Obtén tu API key gratis en: https://console.groq.com/
GROQ_API_KEY=TU_API_KEY_GROQ
